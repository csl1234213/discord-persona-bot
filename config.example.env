# Copy to config.env; supply your own IDs. Never reuse the author's application.
DISCORD_GUILD_ID=
DISCORD_CHAT_CHANNEL_ID=
DISCORD_OWNER_USER_IDS=
DISCORD_ENABLE_MESSAGE_CONTENT_INTENT=true
DISCORD_SYNC_COMMANDS_ON_STARTUP=true
LLM_PROVIDER=fake
# For a trusted local Ollama, configure its own base URL, model and dummy API key.
# Docker Desktop containers reach the host via host.docker.internal, not 127.0.0.1.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=512
LLM_FALLBACK_ENABLED=false
VOICE_ASSET_FEATURE_ENABLED=false
CHAT_DIRECT_UTTERANCE_MODE=true
MAX_CONCURRENT_CHAT_REQUESTS=4
MAX_CONCURRENT_LLM_CALLS=2
MAX_PENDING_CHAT_REQUESTS=16
MAX_CHAT_INPUT_CHARS=4000
CONVERSATION_RETENTION_DAYS=7
MAX_CONVERSATION_MESSAGES=20
SECURITY_USER_DAILY_REQUESTS=100
SECURITY_GLOBAL_DAILY_REQUESTS=1000
SECURITY_USER_DAILY_TOKENS=200000
SECURITY_GLOBAL_DAILY_TOKENS=2000000
SECURITY_USER_DAILY_COST_MICROS=2000000
SECURITY_GLOBAL_DAILY_COST_MICROS=20000000
# Integer millionths of USD per token, verified worst-case across ALL providers.
# Required for a real provider; use 0 only for a verified non-billed local service.
# Fake provider does not need this. Do not guess external API prices.
# SECURITY_PRICE_MICROS_PER_TOKEN=
SECURITY_MAX_PROMPT_BYTES=32768
SECURITY_REQUEST_TIMEOUT_SECONDS=120
SECURITY_RETENTION_DAYS=7
SECURITY_CLEANUP_INTERVAL_SECONDS=300
SECURITY_MAX_CONVERSATIONS=2000
SECURITY_MAX_MESSAGES=20000
SECURITY_DATABASE_MAX_BYTES=268435456
