FROM python:3.11.17-alpine@sha256:d9368b3a5ac59afea7b5d4f2e2aea0941dbf9fdee9c369c5bec00b98244bc929 AS build
RUN apk add --no-cache zlib=1.3.2-r1
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONPATH=/app
WORKDIR /app
RUN addgroup -g 10001 -S persona && adduser -u 10001 -S -D -H -G persona persona
COPY requirements.lock build-tools.lock ./
RUN python -m pip install --no-cache-dir --require-hashes -r build-tools.lock
RUN python -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r requirements.lock
COPY app ./app
COPY bot ./bot
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini
COPY scripts/container_entrypoint.py scripts/healthcheck.py scripts/seed_demo_persona.py scripts/offline_security_smoke.py ./scripts/
RUN mkdir /app/data && chown 10001:10001 /app/data
RUN python -m pip uninstall -y pip setuptools wheel && python -c "import shutil; shutil.rmtree('/usr/local/lib/python3.11/ensurepip')"

# Flatten the reviewed runtime only: removed installer files must not survive in
# distributable lower layers. This copies no host workspace or private mounts.
FROM scratch
COPY --from=build / /
ENV PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app LANG=C.UTF-8
WORKDIR /app
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD ["python", "scripts/healthcheck.py"]
ENTRYPOINT ["python", "scripts/container_entrypoint.py"]
CMD ["python", "-m", "bot.main"]
